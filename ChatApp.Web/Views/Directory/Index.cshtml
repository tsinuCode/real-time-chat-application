@model ChatApp.Web.Models.DirectoryIndexViewModel
@{
    ViewData["Title"] = "Directory";
}

<div class="directory-layout">
    @await Html.PartialAsync("_DesktopSidebar")

    <div class="directory-page">
        <h4 class="mb-3">Search Users</h4>

        <form asp-controller="Directory" asp-action="Index" method="get" class="mb-4">
            <div class="input-group">
                <input type="search"
                       name="query"
                       value="@Model.Query"
                       class="form-control"
                       placeholder="Search by username or email..." />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <h6 class="mb-3">Users</h6>

        @if (Model.Users.Count == 0)
        {
            <p class="text-muted">No users found.</p>
        }
        else
        {
            <ul class="directory-user-list list-unstyled mb-0">
                @foreach (var user in Model.Users)
                {
                    <li class="directory-user-item">
                        <a asp-controller="Directory" asp-action="Details" asp-route-id="@user.Id"
                           class="directory-user-link">
                            <span class="directory-user-dot">●</span>
                            <span>@user.Username</span>
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@await Html.PartialAsync("_MobileSidebarOffcanvas")

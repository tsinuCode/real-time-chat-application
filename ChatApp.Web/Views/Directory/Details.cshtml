@model ChatApp.Web.Models.DirectoryDetailsViewModel
@{
    ViewData["Title"] = "User Profile";
    var user = Model.User!;
}

<div class="directory-layout">
    @await Html.PartialAsync("_DesktopSidebar")

    <div class="directory-page">
        <a asp-controller="Directory" asp-action="Index" class="page-back-link">
            <i class="bi bi-arrow-left"></i> Back to directory
        </a>

        <h4 class="mb-3">Profile</h4>

        <div class="profile-card">
            <div class="detail-row">
                <span class="detail-label">Username</span>
                <span class="detail-value">@user.Username</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Email</span>
                <span class="detail-value text-truncate">@user.Email</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Join Date</span>
                <span class="detail-value">@user.JoinedDate.ToString("yyyy-MM-dd")</span>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_MobileSidebarOffcanvas")

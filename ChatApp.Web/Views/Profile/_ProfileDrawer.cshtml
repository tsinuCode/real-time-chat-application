<div class="offcanvas offcanvas-end profile-drawer" tabindex="-1" id="profileDrawer" aria-labelledby="profileDrawerLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="profileDrawerLabel">Profile</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="profile-drawer-card text-center">
            <div class="avatar-circle avatar-circle-lg mx-auto mb-3">
                @((ViewData["Username"] as string)?[..1].ToUpper())
            </div>
            <h6 class="mb-1">@ViewData["Username"]</h6>
            <p class="text-muted small mb-3">@ViewData["Email"]</p>
            <span class="badge bg-success-subtle text-success">Online</span>
        </div>

        <hr class="border-secondary" />

        <div class="profile-drawer-details">
            <div class="detail-row">
                <span class="detail-label">User ID</span>
                <span class="detail-value text-truncate">@ViewData["UserId"]</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Username</span>
                <span class="detail-value">@ViewData["Username"]</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Email</span>
                <span class="detail-value text-truncate">@ViewData["Email"]</span>
            </div>
        </div>

        <div class="profile-drawer-actions mt-4">
            <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-light btn-sm w-100 mb-2">
                <i class="bi bi-person me-1"></i> View Profile
            </a>
            <a asp-controller="Profile" asp-action="Settings" class="btn btn-outline-light btn-sm w-100">
                <i class="bi bi-gear me-1"></i> Settings
            </a>
        </div>
    </div>
</div>

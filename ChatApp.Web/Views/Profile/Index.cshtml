@{
    ViewData["Title"] = "Profile";
}

<div class="directory-layout">
    @await Html.PartialAsync("_DesktopSidebar")

    <div class="profile-page">
        <a asp-controller="Chat" asp-action="Index" class="page-back-link">
            <i class="bi bi-arrow-left"></i> Back to chats
        </a>

        <div class="profile-card text-center">
            <div class="avatar-circle avatar-circle-lg mx-auto mb-3">
                @((ViewData["Username"] as string)?[..1].ToUpper())
            </div>
            <h4 class="mb-1">@ViewData["Username"]</h4>
            <p class="text-muted mb-3">@ViewData["Email"]</p>
            <span class="badge bg-success-subtle text-success">Online</span>
        </div>

        <div class="profile-card mt-3">
            <h6 class="mb-3">Account Details</h6>
            <div class="detail-row">
                <span class="detail-label">User ID</span>
                <span class="detail-value text-truncate">@ViewData["UserId"]</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Username</span>
                <span class="detail-value">@ViewData["Username"]</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Email</span>
                <span class="detail-value text-truncate">@ViewData["Email"]</span>
            </div>
        </div>

        <div class="d-grid gap-2 mt-3">
            <a asp-controller="Profile" asp-action="Settings" class="btn btn-outline-light">
                <i class="bi bi-gear me-1"></i> Settings
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline-danger w-100">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </button>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_MobileSidebarOffcanvas")

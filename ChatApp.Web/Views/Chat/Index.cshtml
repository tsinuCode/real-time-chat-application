@{
    ViewData["Title"] = "Chats";
}

<div id="chatDashboard"
     class="chat-dashboard show-list"
     data-api-url="@ViewData["ApiBaseUrl"]"
     data-hub-url="@ViewData["HubUrl"]"
     data-user-id="@ViewData["UserId"]"
     data-jwt-token="@ViewData["JwtToken"]">
    <aside class="chat-sidebar d-none d-lg-flex">
        <button type="button" class="sidebar-profile profile-trigger" data-bs-toggle="offcanvas" data-bs-target="#profileDrawer">
            <div class="avatar-circle">@((ViewData["Username"] as string)?[..1].ToUpper())</div>
            <div class="text-start">
                <div class="fw-semibold">@ViewData["Username"]</div>
                <div class="text-success small">Online</div>
            </div>
            <i class="bi bi-chevron-right ms-auto text-muted"></i>
        </button>
        <nav class="sidebar-nav">
            <a href="#" class="sidebar-link active"><i class="bi bi-chat-dots"></i> Personal Chats</a>
            <a href="#" class="sidebar-link"><i class="bi bi-people"></i> Groups</a>
            <a href="#" class="sidebar-link"><i class="bi bi-person-check"></i> Online Users</a>
            <a href="#" class="sidebar-link"><i class="bi bi-gear"></i> Settings</a>
        </nav>
    </aside>

    <section id="chatListPanel" class="chat-list-panel">
        <div class="panel-header">
            <h2 class="h6 mb-0">Chats</h2>
            <input type="search" id="chatSearch" class="form-control form-control-sm mt-2 chat-search" placeholder="Search conversations..." />
        </div>
        <div id="chatListItems" class="chat-list-items">
            <div id="chatListEmpty" class="chat-list-empty d-none">No conversations found</div>
        </div>
    </section>

    <section id="chatActivePanel" class="chat-active-panel">
        <div class="active-chat-header">
            <button id="mobileBackButton" type="button" class="btn btn-link text-white d-lg-none mobile-back-btn" aria-label="Back to chats">
                <i class="bi bi-arrow-left fs-5"></i>
            </button>
            <div class="active-chat-header-info">
                <div id="activeChatTitle" class="fw-semibold">Select a chat</div>
                <div id="activeChatSubtitle" class="small text-muted">Choose a conversation from the list</div>
                <div id="connectionStatus" class="connection-status small text-muted">Connecting...</div>
            </div>
            <button type="button" class="btn btn-link text-white d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#profileDrawer">
                <i class="bi bi-person-circle fs-5"></i>
            </button>
        </div>

        <div id="chatPlaceholder" class="chat-placeholder">
            <i class="bi bi-chat-left-text display-4"></i>
            <p class="mb-0 mt-3">Select a chat to start messaging</p>
        </div>

        <div id="messagesPanel" class="messages-panel d-none">
            <div id="messagesContainer" class="messages-container"></div>
            <div id="typingIndicator" class="typing-indicator d-none">
                <span class="typing-dot"></span>
                <span class="typing-dot"></span>
                <span class="typing-dot"></span>
                <span class="typing-text">typing...</span>
            </div>
        </div>

        <div id="chatComposer" class="chat-composer d-none">
            <input id="messageInput" type="text" class="form-control" placeholder="Type a message..." autocomplete="off" />
            <button id="sendButton" type="button" class="btn btn-primary"><i class="bi bi-send"></i></button>
        </div>
    </section>
</div>

<div class="offcanvas offcanvas-start chat-sidebar-offcanvas" tabindex="-1" id="sidebarOffcanvas">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">Menu</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <button type="button" class="sidebar-profile profile-trigger w-100 mb-3" data-bs-toggle="offcanvas" data-bs-target="#profileDrawer">
            <div class="avatar-circle">@((ViewData["Username"] as string)?[..1].ToUpper())</div>
            <div class="text-start">
                <div class="fw-semibold">@ViewData["Username"]</div>
                <div class="text-success small">Online</div>
            </div>
        </button>
        <nav class="sidebar-nav">
            <a href="#" class="sidebar-link active"><i class="bi bi-chat-dots"></i> Personal Chats</a>
            <a href="#" class="sidebar-link"><i class="bi bi-people"></i> Groups</a>
            <a href="#" class="sidebar-link"><i class="bi bi-person-check"></i> Online Users</a>
            <a href="#" class="sidebar-link"><i class="bi bi-gear"></i> Settings</a>
        </nav>
    </div>
</div>

@await Html.PartialAsync("~/Views/Profile/_ProfileDrawer.cshtml")

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
